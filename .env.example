# Flask
SECRET_KEY=change-this-to-a-random-secret-key-in-production
FLASK_ENV=development

# 数据库
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wenya

# AI 配置（使用兼容 OpenAI 格式的 API）
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=your-openai-api-key-here
AI_MODEL=gpt-4
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# AI 提供商选择 (openai/claude/aliyun/deepseek/moonshot)
AI_PROVIDER=openai

# 增强功能开关
AI_ENABLE_MEMORY=true      # 启用增强记忆能力
AI_ENABLE_CACHE=true       # 启用 API 调用缓存

# 内容安全（百度内容审核）
CONTENT_SAFE_API_KEY=your-bce-api-key
CONTENT_SAFE_ENABLED=false

# Redis（用于限流，开发环境可用 memory）
REDIS_URL=memory://

# 合规公示
ICP_NUMBER=
ALGORITHM_NUMBER=

# 前端 API 地址
VITE_API_URL=http://localhost:5000/api
