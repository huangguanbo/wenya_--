/* 排行榜页样式 */
.container {
  padding: 20rpx;
  padding-bottom: 140rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #6b7280;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.tab-item.active {
  background-color: #16a34a;
  color: #fff;
  font-weight: 500;
}

/* 维度选择器 */
.dimension-selector {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #374151;
}

.arrow {
  color: #9ca3af;
  font-size: 20rpx;
}

/* 前三名 */
.top-three {
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 40rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.top-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.top-item.first {
  order: 2;
  transform: translateY(-20rpx);
}

.top-item.second {
  order: 1;
}

.top-item.third {
  order: 3;
}

.rank-badge {
  position: absolute;
  top: -20rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}

.rank-badge.gold {
  background: linear-gradient(135deg, #fbbf24, #d97706);
}

.rank-badge.silver {
  background: linear-gradient(135deg, #e5e7eb, #9ca3af);
}

.rank-badge.bronze {
  background: linear-gradient(135deg, #f59e0b, #b45309);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #e5e7eb;
  background-size: cover;
  background-position: center;
  margin-bottom: 12rpx;
}

.nickname {
  font-size: 24rpx;
  color: #374151;
  margin-bottom: 8rpx;
}

.score {
  font-size: 32rpx;
  font-weight: bold;
  color: #16a34a;
}

/* 排行榜列表 */
.ranking-items {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 0 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.ranking-item:last-child {
  border-bottom: none;
}

.rank-num {
  width: 60rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #9ca3af;
  text-align: center;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #e5e7eb;
  background-size: cover;
  background-position: center;
  margin: 0 20rpx;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-nickname {
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 8rpx;
}

.user-grade {
  font-size: 22rpx;
  color: #9ca3af;
}

.user-score {
  text-align: right;
}

.score-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #16a34a;
  display: block;
}

.score-label {
  font-size: 20rpx;
  color: #9ca3af;
  display: block;
}

/* 我的排名卡片 */
.my-rank-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.my-rank-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.rank-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #16a34a;
}

.my-rank-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.stat {
  background-color: #f9fafb;
  border-radius: 8rpx;
  padding: 20rpx;
  text-align: center;
}

.stat-label {
  font-size: 22rpx;
  color: #9ca3af;
  display: block;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
  display: block;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #9ca3af;
  font-size: 26rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f3f4f6;
  border-top-color: #16a34a;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
