<view class="container">
  <!-- 登录卡片 -->
  <view class="login-card">
    <view class="logo">
      <text class="logo-text">🌱 文芽</text>
      <text class="logo-subtitle">未成年人 AI 写作练习平台</text>
    </view>

    <!-- 微信一键登录 -->
    <view class="wechat-login-section">
      <button class="wechat-btn" bindtap="wechatLogin">
        <text class="wechat-icon">💚</text>
        <text>微信一键登录</text>
      </button>
      <text class="wechat-tip">使用微信身份快捷登录，无需注册</text>
    </view>
  </view>

  <!-- 用户协议 -->
  <view class="agreement">
    <text class="agreement-text">登录即代表您同意</text>
    <text class="agreement-link" bindtap="showUserAgreement">《用户协议》</text>
    <text class="agreement-text">和</text>
    <text class="agreement-link" bindtap="showPrivacyPolicy">《隐私政策》</text>
  </view>
</view>
