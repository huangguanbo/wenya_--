/* 登录页样式 */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
  background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
}

/* 登录卡片 */
.login-card {
  width: 100%;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

/* Logo */
.logo {
  text-align: center;
  margin-bottom: 48rpx;
}

.logo-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #16a34a;
  display: block;
}

.logo-subtitle {
  font-size: 24rpx;
  color: #6b7280;
  display: block;
  margin-top: 12rpx;
}

/* 微信登录按钮 */
.wechat-login-section {
  margin-bottom: 24rpx;
}

.wechat-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #07c160;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 500;
}

.wechat-btn::after {
  border: none;
}

.wechat-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.wechat-tip {
  display: block;
  text-align: center;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

/* 用户协议 */
.agreement {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
}

.agreement-text {
  margin: 0 4rpx;
}

.agreement-link {
  color: #16a34a;
}
