/* 注册页样式 */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 40rpx;
  background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
}

/* 注册卡片 */
.register-card {
  width: 100%;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

/* Logo */
.logo {
  text-align: center;
  margin-bottom: 40rpx;
}

.logo-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #16a34a;
  display: block;
}

.logo-subtitle {
  font-size: 26rpx;
  color: #6b7280;
  display: block;
  margin-top: 12rpx;
}

/* 微信授权 */
.wechat-section {
  margin-bottom: 32rpx;
  text-align: center;
}

.wechat-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background-color: #07c160;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.wechat-btn::after {
  border: none;
}

.wechat-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.wechat-tip {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 16rpx;
}

/* 表单 */
.register-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.form-item {
  background-color: #f3f4f6;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.input {
  height: 88rpx;
  font-size: 28rpx;
  width: 100%;
}

.picker-value {
  height: 88rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #374151;
}

.picker-value.placeholder {
  color: #9ca3af;
}

.arrow {
  color: #9ca3af;
  font-size: 20rpx;
}

.code-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.code-input .input {
  flex: 1;
  background-color: transparent;
}

.code-btn {
  background-color: #f0fdf4;
  color: #16a34a;
  border: none;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  margin-left: 16rpx;
}

.code-btn::after {
  border: none;
}

.code-btn.disabled {
  background-color: #f3f4f6;
  color: #9ca3af;
}

/* 监护人同意 */
.guardian-agreement {
  padding: 20rpx 0;
}

.agreement-label {
  display: flex;
  align-items: flex-start;
}

checkbox {
  margin-right: 12rpx;
  transform: scale(0.9);
}

.agreement-text {
  font-size: 24rpx;
  color: #6b7280;
  flex: 1;
}

.agreement-link {
  color: #16a34a;
}

/* 注册按钮 */
.btn-primary.full-width {
  width: 100%;
  padding: 28rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

.btn-primary.full-width::after {
  border: none;
}

.btn-primary.full-width[disabled] {
  background-color: #9ca3af;
}

/* 登录链接 */
.login-link {
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
}

.link {
  color: #16a34a;
  margin-left: 8rpx;
}
