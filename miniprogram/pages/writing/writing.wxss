/* 写作页样式 */
.writing-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #fff;
}

/* 标题栏 */
.title-bar {
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.title-input {
  font-size: 32rpx;
  font-weight: bold;
  width: 100%;
  padding: 10rpx 0;
}

/* 编辑器 */
.editor-container {
  flex: 1;
  padding: 30rpx;
  overflow: hidden;
}

.editor {
  width: 100%;
  height: 100%;
  font-size: 28rpx;
  line-height: 1.8;
  border: none;
  outline: none;
}

/* 底部工具栏 */
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f3f4f6;
  background-color: #fff;
}

.word-count {
  font-size: 24rpx;
  color: #6b7280;
}

.save-status {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
}

.action-buttons button {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}

/* AI 浮动按钮 */
.ai-fab {
  position: fixed;
  right: 30rpx;
  bottom: 180rpx;
  width: 100rpx;
  height: 100rpx;
  background-color: #16a34a;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(22, 163, 74, 0.4);
  z-index: 100;
}

.ai-fab text {
  font-size: 48rpx;
}

/* AI 对话面板 */
.ai-chat-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60vh;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  transform: translateY(100%);
  transition: transform 0.3s ease;
  z-index: 99;
  display: flex;
  flex-direction: column;
}

.ai-chat-panel.show {
  transform: translateY(0);
}

/* 聊天历史 */
.chat-history {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

.empty-chat {
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.message-item {
  margin-bottom: 20rpx;
  display: flex;
}

.message-item.user {
  justify-content: flex-end;
}

.message-item.assistant {
  justify-content: flex-start;
}

.message-bubble {
  max-width: 80%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.message-bubble.user {
  background-color: #16a34a;
  color: #fff;
}

.message-bubble.assistant {
  background-color: #f3f4f6;
  color: #374151;
}

/* 加载动画 */
.loading-dots {
  display: flex;
  gap: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #9ca3af;
  border-radius: 50%;
  animation: bounce 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes bounce {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f3f4f6;
  border-bottom: 1rpx solid #f3f4f6;
}

.action-tag {
  background-color: #f0fdf4;
  color: #16a34a;
  border: none;
  border-radius: 20rpx;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
}

.action-tag::after {
  border: none;
}

/* 输入框 */
.chat-input-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  gap: 16rpx;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background-color: #f3f4f6;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 26rpx;
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  background-color: #16a34a;
  color: #fff;
  border: none;
  border-radius: 36rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn:active {
  background-color: #15803d;
}

.send-btn[disabled] {
  background-color: #9ca3af;
}
