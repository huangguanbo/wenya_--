/* 个人中心页样式 */
.container {
  padding: 20rpx;
  padding-bottom: 140rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #16a34a 0%, #059669 100%);
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  color: #fff;
}

.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.3);
  background-size: cover;
  background-position: center;
  margin-right: 24rpx;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.user-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  background-color: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.settings-icon {
  font-size: 40rpx;
  padding: 10rpx;
}

/* 统计数据 */
.user-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 24rpx 0;
}

.stat-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.9;
  display: block;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

/* 菜单区域 */
.menu-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 26rpx;
  color: #6b7280;
  padding: 20rpx 20rpx 12rpx;
  display: block;
}

.menu-list {
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-label {
  font-size: 28rpx;
  color: #374151;
}

.arrow {
  font-size: 40rpx;
  color: #d1d5db;
}

/* 退出登录 */
.logout-section {
  padding: 20rpx;
}

.logout-btn {
  background-color: #fff;
  color: #ef4444;
  border: 1rpx solid #fee2e2;
  border-radius: 12rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
}

.logout-btn::after {
  border: none;
}

/* 底部信息 */
.footer-info {
  text-align: center;
  padding: 40rpx 0;
}

.icp,
.algorithm {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin: 8rpx 0;
}
