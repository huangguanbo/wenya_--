<view class="container">
  <!-- 作文详情 -->
  <view class="work-detail-card">
    <view class="work-header">
      <text class="work-title">{{work.title}}</text>
      <view class="work-meta">
        <text>{{work.word_count}}字</text>
        <text>{{work.created_at}}</text>
      </view>
    </view>
    
    <scroll-view class="work-content" scroll-y>
      <text class="content-text">{{work.content}}</text>
    </scroll-view>
  </view>

  <!-- 评分卡片（已评分） -->
  <view class="score-card" wx:if="{{work.overall_score}}">
    <view class="score-header">
      <text class="score-title">📊 评分详情</text>
      <view class="overall-score">
        <text class="score-value">{{work.overall_score}}</text>
        <text class="score-unit">总分</text>
      </view>
    </view>
    
    <!-- 七维度评分 -->
    <view class="dimensions">
      <view class="dimension-item" wx:for="{{dimensions}}" wx:key="name">
        <view class="dimension-header">
          <text class="dimension-name">{{item.name}}</text>
          <text class="dimension-score">{{item.score}}</text>
        </view>
        <view class="dimension-bar">
          <view class="dimension-fill" style="width: {{item.percent}}%"></view>
        </view>
      </view>
    </view>
    
    <!-- AI 评语 -->
    <view class="ai-comment">
      <view class="comment-header">
        <text class="comment-icon">🤖</text>
        <text class="comment-title">AI 教练点评</text>
      </view>
      <text class="comment-text">{{work.ai_comment}}</text>
      
      <!-- 修改建议 -->
      <view class="suggestions" wx:if="{{work.suggestions && work.suggestions.length}}">
        <text class="suggestions-title">💡 修改建议</text>
        <view class="suggestion-item" wx:for="{{work.suggestions}}" wx:key="index">
          <text class="suggestion-icon">•</text>
          <text class="suggestion-text">{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar">
    <button class="btn-secondary" bindtap="continueEdit" wx:if="{{work.status === 'draft'}}">
      继续编辑
    </button>
    <button class="btn-primary" bindtap="shareWork">
      分享作品
    </button>
  </view>
</view>
