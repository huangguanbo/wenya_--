/* 日志页样式 */
.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1f2937 0%, #374151 100%);
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.stat-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.stat-value.error {
  color: #f87171;
}

.stat-value.warning {
  color: #fbbf24;
}

.stat-value.total {
  color: #60a5fa;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.8;
  display: block;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.2);
  margin: 0 20rpx;
}

/* 操作栏 */
.action-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.action-bar button {
  flex: 1;
  padding: 16rpx 0;
  font-size: 24rpx;
  border-radius: 8rpx;
  border: none;
}

.btn-secondary {
  background-color: #fff;
  color: #374151;
}

.btn-secondary::after {
  border: none;
}

.btn-danger {
  background-color: #fee2e2;
  color: #ef4444;
}

.btn-danger::after {
  border: none;
}

/* 日志列表 */
.logs-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.log-item {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  border-left: 4rpx solid #9ca3af;
}

.log-item.error {
  border-left-color: #ef4444;
}

.log-item.warning {
  border-left-color: #f59e0b;
}

.log-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.log-level {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-weight: bold;
}

.level-text {
  font-size: 24rpx;
}

.log-level.error .level-text {
  color: #ef4444;
}

.log-level.warning .level-text {
  color: #f59e0b;
}

.log-time {
  font-size: 22rpx;
  color: #9ca3af;
}

.log-page {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
  padding: 8rpx 16rpx;
  background-color: #f9fafb;
  border-radius: 4rpx;
}

.page-icon {
  font-size: 24rpx;
}

.log-message {
  font-size: 26rpx;
  color: #1f2937;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.log-data {
  background-color: #f9fafb;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.data-label {
  font-size: 22rpx;
  color: #6b7280;
  display: block;
  margin-bottom: 8rpx;
}

.data-content {
  font-size: 20rpx;
  color: #4b5563;
  font-family: monospace;
  white-space: pre-wrap;
  word-break: break-all;
}

.log-footer {
  text-align: right;
  border-top: 1rpx solid #f3f4f6;
  padding-top: 12rpx;
}

.toggle-detail {
  font-size: 24rpx;
  color: #16a34a;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #9ca3af;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-tip {
  font-size: 24rpx;
  margin-top: 12rpx;
  color: #d1d5db;
}
