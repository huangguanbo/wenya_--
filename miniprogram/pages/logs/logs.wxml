<view class="container">
  <!-- 日志统计 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value error">{{stats.errorCount}}</text>
      <text class="stat-label">错误</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value warning">{{stats.warningCount}}</text>
      <text class="stat-label">警告</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value total">{{stats.totalCount}}</text>
      <text class="stat-label">总计</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar">
    <button class="btn-secondary" bindtap="refreshLogs">
      🔄 刷新
    </button>
    <button class="btn-secondary" bindtap="exportLogs">
      📤 导出
    </button>
    <button class="btn-danger" bindtap="clearLogs">
      🗑️ 清空
    </button>
  </view>

  <!-- 日志列表 -->
  <view class="logs-list">
    <view 
      class="log-item {{item.level}}"
      wx:for="{{logs}}"
      wx:key="id"
    >
      <view class="log-header">
        <view class="log-level {{item.level}}">
          <text>{{item.level === 'error' ? '❌' : '⚠️'}}</text>
          <text class="level-text">{{item.level === 'error' ? 'ERROR' : 'WARNING'}}</text>
        </view>
        <text class="log-time">{{item.timestampLocal}}</text>
      </view>
      
      <view class="log-page">
        <text class="page-icon">📄</text>
        <text>{{item.page}}</text>
      </view>
      
      <view class="log-message">{{item.message}}</view>
      
      <view class="log-data" wx:if="{{item.data && showDetails[index]}}">
        <text class="data-label">详细数据:</text>
        <text class="data-content">{{formatData(item.data)}}</text>
      </view>
      
      <view class="log-footer">
        <text 
          class="toggle-detail"
          bindtap="toggleDetail"
          data-index="{{index}}"
        >
          {{showDetails[index] ? '收起详情' : '查看详情'}}
        </text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{logs.length === 0}}">
    <text class="empty-icon">📝</text>
    <text>暂无日志记录</text>
    <text class="empty-tip">错误和警告日志会显示在这里</text>
  </view>
</view>
