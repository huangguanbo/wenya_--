<view class="container">
  <!-- 筛选栏 -->
  <view class="filter-bar">
    <picker 
      mode="selector" 
      range="{{gradeOptions}}" 
      range-key="label"
      value="{{gradeIndex}}"
      bindchange="onGradeChange"
    >
      <view class="filter-item">
        <text>{{gradeOptions[gradeIndex].label}}</text>
        <text class="arrow">▼</text>
      </view>
    </picker>
    
    <picker 
      mode="selector" 
      range="{{sortOptions}}" 
      range-key="label"
      value="{{sortIndex}}"
      bindchange="onSortChange"
    >
      <view class="filter-item">
        <text>{{sortOptions[sortIndex].label}}</text>
        <text class="arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 作品列表 -->
  <view class="works-list">
    <view 
      class="work-card"
      wx:for="{{works}}"
      wx:key="id"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <view class="work-header">
        <view class="author-info">
          <view class="author-avatar" style="background-image: url({{item.author_avatar}})"></view>
          <view class="author-detail">
            <text class="author-name">{{item.author_name}}</text>
            <text class="publish-time">{{item.created_at}}</text>
          </view>
        </view>
        <view class="work-score" wx:if="{{item.overall_score}}">
          <text class="score-value">{{item.overall_score}}</text>
          <text class="score-label">分</text>
        </view>
      </view>
      
      <view class="work-content">
        <text class="work-title">{{item.title}}</text>
        <text class="work-excerpt ellipsis-3">{{item.excerpt}}</text>
      </view>
      
      <view class="work-footer">
        <view class="work-meta">
          <text class="word-count">{{item.word_count}}字</text>
          <text class="grade-tag">{{item.grade_name}}</text>
        </view>
        
        <view class="interactions">
          <view class="interaction-item" bindtap="toggleLike" data-id="{{item.id}}" catchtap="true">
            <text class="icon {{item.is_liked ? 'liked' : ''}}">❤️</text>
            <text class="count">{{item.like_count}}</text>
          </view>
          <view class="interaction-item">
            <text class="icon">💬</text>
            <text class="count">{{item.comment_count}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}">
    <text>加载更多...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{works.length === 0 && !loading}}">
    <text>暂无作品</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>
</view>
