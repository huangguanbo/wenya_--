/* 社区页样式 */
.container {
  padding: 20rpx;
  padding-bottom: 140rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.filter-item {
  flex: 1;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #374151;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.arrow {
  color: #9ca3af;
  font-size: 20rpx;
}

/* 作品卡片 */
.works-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.work-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.work-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.author-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.author-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #e5e7eb;
  background-size: cover;
  background-position: center;
  margin-right: 16rpx;
}

.author-detail {
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
}

.publish-time {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.work-score {
  text-align: center;
}

.score-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #16a34a;
  display: block;
}

.score-label {
  font-size: 20rpx;
  color: #9ca3af;
  display: block;
}

/* 作品内容 */
.work-content {
  margin-bottom: 20rpx;
}

.work-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1f2937;
  display: block;
  margin-bottom: 12rpx;
}

.work-excerpt {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
  display: block;
}

/* 作品底部 */
.work-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}

.work-meta {
  display: flex;
  gap: 12rpx;
}

.word-count {
  font-size: 22rpx;
  color: #9ca3af;
}

.grade-tag {
  background-color: #f0fdf4;
  color: #16a34a;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
}

/* 互动区 */
.interactions {
  display: flex;
  gap: 24rpx;
}

.interaction-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.icon {
  font-size: 28rpx;
}

.icon.liked {
  animation: heartBeat 0.3s ease;
}

.count {
  font-size: 22rpx;
  color: #6b7280;
}

@keyframes heartBeat {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.3);
  }
  100% {
    transform: scale(1);
  }
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  color: #9ca3af;
  font-size: 26rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
  color: #9ca3af;
  font-size: 26rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f3f4f6;
  border-top-color: #16a34a;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 文本截断 */
.ellipsis-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
